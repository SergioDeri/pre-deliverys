# Compartido por todas las pre-entregas: cada main.py busca el .env subiendo de carpeta.
# Clave gratuita en https://console.groq.com/keys
GROQ_API_KEY=

# Opcionales. Sin valor, cada pre-entrega usa su modelo por defecto
# (preentrega-1: openai/gpt-oss-20b, preentrega-2: openai/gpt-oss-120b).
LLM_PROVIDER=groq
GROQ_MODEL=

# Pre-entrega 3: embeddings de Gemini. Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Compartida por las pre-entregas 3 y 4. Sin valor se usa gemini-embedding-001. La 4 pide
# 1536 dimensiones: un modelo que no las soporte rompe su índice.
GEMINI_EMBEDDING_MODEL=

# Opcionales de la pre-entrega 3. Sin valor se usan chunks de 800 caracteres con 120 de
# solapamiento y la colección "docs" en preentrega-3/chroma_db/.
CHUNK_SIZE=
CHUNK_OVERLAP=
CHROMA_DIR=
CHROMA_COLLECTION=

# Pre-entrega 4: usa la misma GEMINI_API_KEY y además Pinecone.
# Clave gratuita en https://app.pinecone.io (API Keys).
PINECONE_API_KEY=

# Opcionales de la pre-entrega 4. Sin valor se usan el índice "payflow", chunks de
# 600 tokens con 80 de solapamiento y pesos 0.5 vectorial / 0.5 BM25.
PINECONE_INDEX_NAME=
CHUNK_TOKENS=
CHUNK_OVERLAP_TOKENS=
HYBRID_VECTOR_WEIGHT=

# Pre-entrega 5: usa la misma GROQ_API_KEY. Con GROQ_MODEL vacío usa openai/gpt-oss-120b;
# si lo cambiás para la 1 o la 2, tiene que ser un modelo con tool calling o el agente falla.

# Pre-entrega 6: usa la misma GROQ_API_KEY y el mismo GROQ_MODEL que la 5 (con tool calling y
# salida estructurada). No necesita otras claves.

# Pre-entrega 7: usa la misma GROQ_API_KEY. Para la prueba de concurrencia conviene
# GROQ_MODEL=openai/gpt-oss-20b (ver el README de la P7). Con docker compose, REDIS_URL y
# PHOENIX_COLLECTOR_ENDPOINT los fija el compose y estos valores se ignoran.
REDIS_URL=redis://localhost:6379
# Sin valor no se envían trazas. Con el Phoenix del compose: http://localhost:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=incident-orchestrator
# Opcionales: trabajos simultáneos (5) y días que se guardan trabajos y checkpoints (7).
MAX_CONCURRENT_JOBS=
JOB_TTL_DAYS=
